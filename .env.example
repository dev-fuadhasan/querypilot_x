# Vercel -> Project Settings -> Environment Variables
# Required: random secret, at least 32 characters. Never expose as NEXT_PUBLIC_*.
SESSION_SECRET=replace-this-with-a-strong-unique-32-plus-character-secret

# Choose the default free-tier Gemini API (recommended):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Or use a Groq API key, optionally as a fallback if Gemini is rate-limited.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_PROVIDER=auto

# Required for the browser's ONE-CLICK Supabase OAuth connection workflow.
# Create a Supabase OAuth app (not a project API key).
# Enable "Projects: Read" and "Database: Read"; do not grant Database: Write.
APP_URL=http://localhost:3000
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=

# If Supabase OAuth isn't configured, users can still connect with
# each project's own PostgreSQL read-only URI through the manual setup.
