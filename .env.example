# Required: use a cryptographically random secret (32+ characters), shared across all Vercel functions.
SESSION_SECRET=replace-with-a-strong-random-32-plus-character-secret
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# Optional: register a Supabase MANAGEMENT OAuth integration to allow users to authorize and select projects.
# The published OAuth app redirect URI must exactly match APP_URL/api/auth/callback.
# Without these variables, a manual Supabase PostgreSQL connection form is available.
APP_URL=http://localhost:3000
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
